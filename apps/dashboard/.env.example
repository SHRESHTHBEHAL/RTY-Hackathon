# Where the dashboard gets its data.
#   fixtures (default): an in-memory backend inside the Next.js server, seeded
#                       with "Acme Ops" (business) and "Relay" (seller).
#   live:               the real Gaitway API at NEXT_PUBLIC_API_BASE.
API_MODE=fixtures
NEXT_PUBLIC_API_BASE=http://localhost:8787

# Optional, fixtures only: artificial latency per request, in milliseconds.
# Useful for looking at loading states.
FIXTURE_LATENCY_MS=0
