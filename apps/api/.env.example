# Gaitway Core API settings (context.md section 10). Copy to .env.
DATABASE_URL=postgres://gaitway:gaitway@localhost:5432/gaitway
# Tests use this database; it is created automatically if missing.
TEST_DATABASE_URL=postgres://gaitway:gaitway@localhost:5432/gaitway_test
GAITWAY_ISSUER=http://localhost:8787
PORT=8787
PLATFORM_FEE_BPS=0
LIVE_ENABLED=false
# memory = in-process stand-in vault; chain = real vault (wired at integration, context.md section 12)
VAULT_DRIVER=memory
SETTLE_INTERVAL_SECONDS=30
SESSION_SECRET=change-me-to-a-long-random-string
RPC_URL=http://localhost:8545
CHAIN_ID=31337
VAULT_ADDRESS=
USDC_ADDRESS=
ADMIN_PRIVATE_KEY=
TEST_ADDRESS_MNEMONIC=
CONFIRMATIONS=1
# Slots for a currency partner and an identity-check provider. Only SIMULATED versions exist.
RAMP_PROVIDER=none
IDENTITY_PROVIDER=none
# Requests per API key or session in any 10 seconds before HTTP 429
RATE_LIMIT_PER_10S=100
# Browser origins allowed to call the API ("*" or comma-separated list)
CORS_ORIGINS=*
# deployBlock from contracts/deployments/<chainId>.json; deposits are scanned from here
VAULT_DEPLOY_BLOCK=0
