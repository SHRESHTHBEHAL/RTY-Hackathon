{
  "name": "@gaitway/mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent pay for things through Gaitway",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": { "gaitway-mcp": "./dist/main.js" },
  "files": ["dist"],
  "scripts": {
