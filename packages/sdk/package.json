{
  "name": "@gaitway/sdk",
  "version": "0.1.0",
  "description": "Gaitway SDK: seller and agent clients for the agent payment gateway",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-gaitway.d.ts",
      "import": "./dist/testing/mock-gaitway.js",
      "default": "./dist/testing/mock-gaitway.js"
    },
    "./express": {
      "types": "./dist/seller-express.d.ts",
      "import": "./dist/seller-express.js",
      "default": "./dist/seller-express.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "@types/express": "^5.0.0",
    "express": "^5.1.0"
  }
}
