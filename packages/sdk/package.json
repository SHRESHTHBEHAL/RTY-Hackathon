{
  "name": "@gaitway/sdk",
  "version": "0.1.0",
  "description": "Gaitway SDK: seller and agent clients for the agent payment gateway",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-gaitway.d.ts",
      "import": "./dist/testing/mock-gaitway.js",
      "default": "./dist/testing/mock-gaitway.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
